# ==============================================================================
# KNIT Environment Configuration Example
# ==============================================================================

# Backend Settings
APP_NAME=KNIT
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api
DATABASE_URL=sqlite:///./knit.db
# ALLOWED_ORIGINS is accepted as an alias for CORS_ORIGINS. SQLITE_DB_PATH is not used.
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
# AI Studio aliases are accepted alongside these application setting names.
FRONTEND_URL=
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Gemini AI Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=30

# Gmail OAuth (Phase 10.1 configuration only; integration remains disabled)
GMAIL_INTEGRATION_ENABLED=False
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/connections/gmail/callback
GMAIL_OAUTH_SCOPES=["https://www.googleapis.com/auth/gmail.readonly"]
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_SYNC_MAX_MESSAGES=100
GMAIL_SYNC_PAGE_SIZE=25

# Frontend Settings
VITE_API_BASE_URL=http://localhost:8000
