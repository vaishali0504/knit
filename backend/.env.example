# KNIT Backend Environment Variables
APP_NAME=KNIT
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api

# Backend security: set private values only in backend/.env or secret management.
# AI Studio aliases are accepted: JWT_SECRET_KEY, JWT_ACCESS_TOKEN_EXPIRE_MINUTES,
# TOKEN_ENCRYPTION_KEY, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GMAIL_REDIRECT_URI.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
GMAIL_TOKEN_ENCRYPTION_KEY=

# API and database
# ALLOWED_ORIGINS is accepted as an alias for CORS_ORIGINS. SQLITE_DB_PATH is not used.
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
FRONTEND_URL=
DATABASE_URL=sqlite:///./knit.db

# Gemini (backend only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=60

# Gmail OAuth (disabled until credentials are configured and authorization is approved)
GMAIL_INTEGRATION_ENABLED=False
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/connections/gmail/callback
GMAIL_OAUTH_SCOPES=["https://www.googleapis.com/auth/gmail.readonly"]
GMAIL_SYNC_MAX_MESSAGES=100
GMAIL_SYNC_PAGE_SIZE=25
